# MiBee usb-webcam — GOOUUU ESP32-S3-N16R8 + OV5640，UVC over 原生 USB
# 硬件块逐行抄自 cam/sdkconfig.defaults（同板上板验证过）。

CONFIG_IDF_TARGET="esp32s3"

# ---- SoC / Flash / PSRAM（与 cam 一致，16MB Quad Flash + 8MB Octal PSRAM） ----
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# 自定义分区表（partitions.csv）：nvs/phy 偏移对齐 cam → 覆盖刷不动 cam 的 NVS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# 64B cache line 对 Octal DDR 强制（32B 会静默数据损坏——cam 仓教训）
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- 控制台：UART0（CH343 口，115200，serialtap 采集）；副通道全关 ----
# 原生 USB 的 GPIO19/20 被 TinyUSB UVC 占用，控制台绝不能挂在 USB-Serial-JTAG 上
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- 看门狗（固件基线规范第 1 条）----
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ---- USB UVC（espressif/usb_device_uvc Kconfig）----
# USB-FS 实测推荐：VGA@15fps MJPEG，Bulk 传输（esp-iot-solution s3 CI 同款）
CONFIG_UVC_MODE_BULK_CAM1=y
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=n
CONFIG_UVC_CAM1_FRAMESIZE_WIDTH=640
CONFIG_UVC_CAM1_FRAMESIZE_HEIGT=480
CONFIG_UVC_CAM1_FRAMERATE=15
CONFIG_TUSB_MANUFACTURER="MiBee Studio"
CONFIG_TUSB_PRODUCT="MiBee USB Webcam (N16R8)"

# ---- 摄像头 ----
CONFIG_CAMERA_XCLK_FREQ=16
CONFIG_CAMERA_VFLIP=n
CONFIG_CAMERA_HMIRROR=n

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
