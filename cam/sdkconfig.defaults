# Target
CONFIG_IDF_TARGET="esp32s3"

# CPU
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

# PSRAM (8MB Octal) — VERBATIM from verified seeed-esp32s3-cam config
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# 2026-09-04 补漏：SPEED 行此前漏抄，Octal 落到默认 40MHz（seeed 是 80M）。
# XGA+ fb_get NULL/FB-OVF 风暴疑似即此（DVP→PSRAM EDMA 带宽不足）。
CONFIG_SPIRAM_SPEED_80M=y
# 2026-09-04 补漏 2：seeed 有而本仓漏抄——WiFi/lwIP 缓冲迁 PSRAM，腾内部
# DRAM。XGA 复测实锤：cam_hal 16KB DMA 暂存缓冲 malloc 失败（最大空闲块仅
# 15KB/9.7KB）即内部耗尽，与 DVP/模组无关。
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# 64B cache line is MANDATORY for Octal DDR mode. 32B causes silent data corruption.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Flash 16MB (N16 variant)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Watchdog
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
# CPU1=OFF：AI 任务常驻 core 1，运行期 esp_task_wdt_delete(IDLE1) 只删订阅条目
# 不注销空闲钩子 → IDLE1 每轮空转调 esp_task_wdt_reset 刷 "task not found" 洪水
# （2026-09-05 实锤，IDLE1 + ra→task_wdt.c:707）。官方做法是构建期就不订阅。
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Camera — GOOUUU pin mapping (NOT XIAO/seeed)
CONFIG_CAMERA_PIN_PWDN=-1
CONFIG_CAMERA_PIN_RESET=-1
CONFIG_CAMERA_PIN_XCLK=15
CONFIG_CAMERA_PIN_SIOD=4
CONFIG_CAMERA_PIN_SIOC=5
CONFIG_CAMERA_PIN_D0=11
CONFIG_CAMERA_PIN_D1=9
CONFIG_CAMERA_PIN_D2=8
CONFIG_CAMERA_PIN_D3=10
CONFIG_CAMERA_PIN_D4=12
CONFIG_CAMERA_PIN_D5=18
CONFIG_CAMERA_PIN_D6=17
CONFIG_CAMERA_PIN_D7=16
CONFIG_CAMERA_PIN_VSYNC=6
CONFIG_CAMERA_PIN_HREF=7
CONFIG_CAMERA_PIN_PCLK=13
CONFIG_CAMERA_PSRAM_DMA=n

# Wi-Fi
# AMPDU 保持关闭（2026-09-04 复测后维持 =n）：重开 =y 上板实测无增益
# （ping 仍 ~512ms、无 <ba-add>、推流无改善）且伴随一次原因不明的失联；
# 本板 ch11 HT40 弱态的网络调优是独立课题（候选：挪信道/关 HT40），勿仅动 AMPDU。
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# LWIP
# 2026-09-03: 10→16 sockets + MSL 60s→15s — 家族性 EMFILE 修复（PIT-001，见根目录
# PITFALLS.md）：SPA 流看门狗 ~7s 重连，被踢连接 TIME_WAIT 2×MSL 驻留，10 插座必爆
# → httpd accept EMFILE → 自愈重启循环。luatos/seeed/ai-thinker 均已 16+15000。
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_TCP_MSL=15000
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_REUSE_RXTOALL=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_MAX_TASK_NAME_LEN=16
CONFIG_FREERTOS_DEFAULT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Partition table (custom for 16MB Flash)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# SPIFFS
CONFIG_SPIFFS=y

# WebSocket transport
CONFIG_WS_TRANSPORT=y

# C++ support (required by ESP-DL)
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y

# ESP-DL model location (in flash, not PSRAM)
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y

# TCP buffers for congested high-RTT links (family value, proven on seeed 2026-09-03:
# default 5760-byte windows cap MJPEG at ~8KB/s on ch11/HT40 ~300ms RTT paths)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=49152
CONFIG_LWIP_TCP_WND_DEFAULT=32768

# ESPectre CSI 运动感知（2026-09-06 家族推广，PIT-034）：栅格 pps 是链路预算，
# 四仓统一 10（拥塞/弱链路下 admitted 才能过 70% 槽占用下限）。
CONFIG_ESPECTRE_CSI_TARGET_PPS=10
